{{define "base"}}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ebook System</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.7.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="min-h-screen bg-base-300 text-base-content">
    <div class="navbar bg-base-100 shadow-xl mb-4 rounded-b-lg">
        <div class="flex-1">
            <a href="/" class="btn btn-ghost text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">Ebooks Pro</a>
        </div>
        <div class="flex-none">
            <ul class="menu menu-horizontal px-1 font-semibold">
                <li><a href="/">Inicio</a></li>
                <li><a href="/catalog">Catálogo</a></li>
            </ul>
        </div>
    </div>
    <main class="container mx-auto p-4 md:p-8">
        {{template "main" .}}
    </main>
</body>
</html>
{{end}}
