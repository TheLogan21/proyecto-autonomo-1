{{define "base"}}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ebook System</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.7.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="min-h-screen bg-base-300 text-base-content">
    <div class="navbar bg-base-100 shadow-xl mb-4 rounded-b-lg">
        <div class="flex-1">
            <a href="/" class="btn btn-ghost text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">Ebooks Pro</a>
        </div>
        <div class="flex-none">
            <ul class="menu menu-horizontal px-1 font-semibold items-center">
                <li><a href="/">Inicio</a></li>
                <li><a href="/catalog">Catálogo</a></li>
                {{if .UserID}}
                <li><a href="/profile" class="text-primary">Mi Perfil</a></li>
                <li>
                    <form action="/logout" method="POST" class="inline m-0 p-0 ml-2">
                        <button type="submit" class="btn btn-ghost btn-sm">Salir</button>
                    </form>
                </li>
                {{else}}
                <li><a href="/login" class="btn btn-outline btn-sm ml-2">Ingresar</a></li>
                {{end}}
            </ul>
        </div>
    </div>
    <main class="container mx-auto p-4 md:p-8">
        {{if .Error}}
        <dialog id="error_modal" class="modal modal-open">
          <div class="modal-box border border-error">
            <h3 class="font-bold text-2xl text-error mb-4">¡Atención!</h3>
            <p class="py-2 text-lg">{{.Error}}</p>
            <div class="modal-action">
              <form method="dialog">
                <button class="btn btn-primary px-8" onclick="document.getElementById('error_modal').classList.remove('modal-open'); window.history.replaceState(null, '', window.location.pathname);">Aceptar</button>
              </form>
            </div>
          </div>
        </dialog>
        {{end}}

        {{template "main" .}}
    </main>
</body>
</html>
{{end}}
